// =====================================================================
// UsalamaSMS — data model
//
// Every tenant-owned table carries orgId and is indexed on it first.
// Multi-tenancy here is not a feature, it is the security boundary: two
// operators who compete on the same routes share this database, and a
// query that forgets orgId is a data breach between competitors.
//
// Connection URL lives in prisma.config.ts (Prisma 7), not here.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer accepts `url` here — the connection lives in
// prisma.config.ts, and the client takes an adapter. The schema had both,
// which is not a style disagreement: `prisma generate` refuses to run,
// so the client was never generated, so `tsc` could not resolve
// PrismaClient, so twelve of the thirteen type errors in this repository
// were one line in this file.
datasource db {
  provider = "postgresql"
}

enum Role {
  FRONTLINE
  SAFETY_OFFICER
  SAFETY_MANAGER
  INVESTIGATOR
  KEY_MANAGEMENT
  ACCOUNTABLE_EXECUTIVE
  REGULATOR_INSPECTOR
  SYSTEM_ADMIN
}

enum ReportType {
  MOR
  VCR
  HAZARD
  SUGGESTION
  NEAR_MISS
  FATIGUE
}

enum ReportState {
  SUBMITTED
  TRIAGED
  UNDER_INVESTIGATION
  ACTIONS_OPEN
  CLOSED
}

enum Severity {
  A_CATASTROPHIC
  B_HAZARDOUS
  C_MAJOR
  D_MINOR
  E_NEGLIGIBLE
}

enum Likelihood {
  FREQUENT
  OCCASIONAL
  REMOTE
  IMPROBABLE
  EXTREMELY_IMPROBABLE
}

enum Tolerability {
  INTOLERABLE
  TOLERABLE
  ACCEPTABLE
}

enum FlightPhase {
  STANDING
  PUSHBACK
  TAXI
  TAKEOFF
  INITIAL_CLIMB
  CLIMB
  CRUISE
  DESCENT
  APPROACH
  LANDING
  LANDING_ROLL
  GO_AROUND
  GROUND_HANDLING
  MAINTENANCE
}

// A reporting obligation follows the STATE OF REGISTRY. This product
// maintains one State's standard properly — Kenya — and offers ICAO's
// baseline for every other: Annex 13 requires notification with a
// minimum of delay and names no period, so no deadline is computed for
// it.
//
// UG, TZ and RW were removed because all three carried the EU's 72
// hours as an "ICAO-common" default, and there is no such default. The
// EU row itself was then removed for scope rather than accuracy —
// nothing here is built for an EU-registered operator, and a
// jurisdiction on offer is a claim to know its obligations. See
// regulations.ts.
enum Jurisdiction {
  ICAO
  KE
}

model Org {
  id           String       @id @default(uuid())
  name         String
  // The regulator this operator answers to. Drives which reporting
  // obligation row applies — see packages/shared/src/regulations.ts.
  jurisdiction Jurisdiction @default(KE)
  aocNumber    String?
  createdAt    DateTime     @default(now())

  users     User[]
  reports   SafetyReport[]
  hazards   Hazard[]
  auditLogs AuditLog[]
  receipts  SyncReceipt[]
  spis      Spi[]

  // The other eight Annex 19 elements.
  policies         SafetyPolicy[]
  voluntaryScheme  VoluntaryScheme?
  policyReads      PolicyAcknowledgement[]
  accountabilities Accountability[]
  appointments     Appointment[]
  exercises        EmergencyExercise[]
  documents        ControlledDocument[]
  findings         AuditFinding[]
  training         TrainingRecord[]
  communications   SafetyCommunication[]
  changes          ChangeAssessment[]
}

model User {
  id           String   @id @default(uuid())
  orgId        String
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(FRONTLINE)
  mfaSecret    String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  org      Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  reports  SafetyReport[]
  tokens   RefreshToken[]
  receipts SyncReceipt[]
  audits   AuditLog[]

  // Named relations, because a user can appear against one table in
  // more than one role and Prisma cannot guess which is which.
  policiesSigned    SafetyPolicy[]          @relation("policySignatory")
  policyReads       PolicyAcknowledgement[]
  appointments      Appointment[]           @relation("appointee")
  documentsApproved ControlledDocument[]    @relation("documentApprover")
  findingsVerified  AuditFinding[]          @relation("findingVerifier")
  training          TrainingRecord[]        @relation("trainee")
  communications    SafetyCommunication[]   @relation("communicator")
  changesApproved   ChangeAssessment[]      @relation("changeApprover")

  @@index([orgId, role])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model SafetyReport {
  id       String @id @default(uuid())
  orgId    String
  // Client-generated idempotency key for offline submission.
  // Scoped to the org below, not globally unique. See the same note on
  // SyncReceipt: clientId is generated on the device, so a global
  // constraint let one operator's id collide with another's — which
  // raised an uncaught P2002 inside the batch loop, returned 500 for
  // the whole batch, and left the device retrying into it forever. It
  // also answered "does this id exist in another tenancy?" through the
  // status code. The receipt table was fixed; this one was missed.
  clientId String

  type      ReportType
  state     ReportState @default(SUBMITTED)
  title     String
  narrative String      @db.Text

  /// What the reporter thinks should be done about it.
  ///
  /// From the operator's own hazard report form, where "Reporter's
  /// Recommendations" sits above the safety office's analysis. The
  /// person who saw the hazard usually knows the fix, and this is the
  /// cheapest safety intelligence in the system.
  ///
  /// De-identified with the narrative, never separately: a recommendation
  /// can identify its author as readily as the account can.
  reporterRecommendation String? @db.Text

  occurredAt   DateTime?
  // When the reporting obligation began running for this organisation.
  // NOT the same as occurredAt, and the distinction is the difference
  // between meeting a 24-hour deadline and missing it — an engineer who
  // discovers a Friday defect on Monday reports from Monday.
  awareAt      DateTime?
  jurisdiction Jurisdiction @default(KE)

  // Both now hold a code from packages/shared/src/taxonomy.ts rather than
  // whatever someone typed. "HKJK", "JKIA" and "Nairobi" were three
  // aerodromes to a GROUP BY, which made every safety-intelligence
  // question unanswerable. The dropdowns keep a free-text escape, so
  // these are still nullable strings rather than enums — a vocabulary
  // with no way out puts the real answer in the narrative instead.
  location     String?
  aircraftType String?
  phase        FlightPhase?
  hrcTags      String[]

  // ------------------------ Confidentiality ------------------------
  isAnonymous           Boolean   @default(false)
  // Null when anonymous, and null again — permanently — once a VCR has
  // been through de-identification. Hard removal, never reversible
  // encryption: a key that exists is a key that can be compelled.
  reporterId            String?
  isDeIdentified        Boolean   @default(false)
  deIdentifiedAt        DateTime?
  deIdentifiedNarrative String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Org                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  reporter User?                 @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  feedback SafetyCommunication[]
  hazards  Hazard[]

  // DELIBERATELY NOT A COLUMN: regulatorDeadline.
  //
  // Charter rule 6 — regulatory status is computed from today's date,
  // never stored. A stored deadline survives a correction to occurredAt,
  // survives a correction to awareAt, and survives the regulator
  // changing the rule; all three leave the operator holding a number the
  // product is confident about and the authority disagrees with.
  // Computed at read time by reportingDeadline() from jurisdiction +
  // awareAt. If you are about to add this column, read that module first.

  @@unique([orgId, clientId])
  @@index([orgId, state, createdAt])
  @@index([orgId, type, occurredAt])
  // The aggregation this taxonomy exists to make possible.
  @@index([orgId, location, phase])
}

model Hazard {
  id          String  @id @default(uuid())
  orgId       String
  reportId    String?
  title       String
  description String  @db.Text
  source      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org         Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  report      SafetyReport?    @relation(fields: [reportId], references: [id], onDelete: SetNull)
  assessments RiskAssessment[]

  @@index([orgId, createdAt])
}

model RiskAssessment {
  id          String @id @default(uuid())
  orgId       String
  hazardId    String
  consequence String @db.Text

  severity     Severity
  likelihood   Likelihood
  // Stored because they are the assessment OF RECORD at a point in time
  // — unlike a regulatory deadline, which is a property of law and
  // changes underneath you. If the matrix is ever revised, historic
  // assessments must keep the classification they were accepted under;
  // recomputing them would rewrite decisions people signed.
  score        Int
  tolerability Tolerability

  alarpJustification String?   @db.Text
  acceptedById       String?
  acceptedAt         DateTime?

  // ------------------------------------------------------------------
  // THE STANDING REGISTER, which is a different artefact from a
  // one-off assessment and was living in a browser.
  //
  // An assessment answers "how bad is this". A register answers "what
  // are we doing about it, who owns it, and when do we look again" —
  // and it is the register an auditor asks for, because a hazard with
  // no owner and no review date has been assessed and not managed.
  // ------------------------------------------------------------------
  controls String? @db.Text

  // The residual position, AFTER the controls above. Stored for exactly
  // the reason the initial pair is: it is the assessment of record at a
  // point in time, and recomputing it if the matrix is ever revised
  // would rewrite a decision somebody signed.
  //
  // Nullable as a set: an entry assessed today and controlled next week
  // has an initial position and no residual one, and inventing a
  // residual equal to the initial would report a control that does not
  // exist.
  residualSeverity     Severity?
  residualLikelihood   Likelihood?
  residualScore        Int?
  residualTolerability Tolerability?

  owner    String?
  // The date the entry is next due to be looked at. A register whose
  // rows have no review date is a list, and the finding an auditor
  // writes is that nobody was going to look again.
  reviewBy DateTime?
  status   RiskStatus @default(OPEN)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  hazard Hazard @relation(fields: [hazardId], references: [id], onDelete: Cascade)

  @@index([orgId, tolerability])
  // The two queries a safety office actually runs against a register:
  // what is open, and what is due.
  @@index([orgId, status])
  @@index([orgId, reviewBy])
}

enum RiskStatus {
  OPEN
  MITIGATED
  ACCEPTED
  CLOSED
}

model Spi {
  id           String   @id @default(uuid())
  orgId        String
  name         String
  // A safety performance indicator, in the shape the product actually
  // computes with. Annex 19 Amendment 2 raises these from good practice
  // to the substance of performance-based oversight, and regulation
  // 9(5) of Kenya's L.N. 32/2026 requires an SMS to HAVE indicators and
  // targets "acceptable to the Authority" — which a figure held in one
  // browser is not.
  //
  // WHAT CHANGED AND WHY. This model used to carry `unit`, `target` and
  // `alertLevel` and nothing else, and no code path ever read or wrote
  // it. Meanwhile the working model — kind, exposure basis, direction,
  // owner, and the periods everything is computed from — lived in
  // localStorage. The table was a guess at a feature that had since
  // been designed somewhere else.
  //
  // `alertLevel` IS GONE, deliberately. It is derived: alertLevels() in
  // packages/shared/src/spi.ts computes it from the series, and a
  // stored alert level is the same defect as a stored deadline —
  // correct on the day it was written and silently wrong after the next
  // period lands. Charter rule 6.
  kind         String
  // What the exposure counts, in the operator's words: sectors, hours,
  // movements, turnarounds.
  exposureUnit String
  // Rate basis: events per this many units of exposure.
  per          Float
  direction    String
  // The target, as a rate on the same basis. Optional because an
  // operator may be measuring before it is ready to commit to a figure,
  // and a required target is how indicators go untracked.
  target       Float?
  owner        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org     Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  periods SpiPeriod[]

  // One indicator per name per operator. Two indicators called "Runway
  // excursions" with different series is a measurement nobody can act
  // on.
  @@unique([orgId, name])
  @@index([orgId])
}

model SpiPeriod {
  id          String    @id @default(uuid())
  // Denormalised onto the period as well as the indicator, because
  // every query in this API is scoped by orgId first and a join is not
  // a tenancy boundary.
  orgId       String
  spiId       String
  // "2026-Q1", "March" — whatever the operator's cadence is called.
  label       String
  events      Int
  exposure    Float
  /// Element 3.1's own evidence definition asks for "a record of what
  /// happened the last time one was crossed". This is that record,
  /// attached to the PERIOD rather than to an alert level — the level
  /// is derived by alertLevels() on every read and is deliberately not
  /// stored, so hanging the action off it would either require storing
  /// it or leave the note orphaned the moment the series moved.
  ///
  /// Nullable, and not required when a level is crossed. A product that
  /// refuses to record the numbers until somebody has written the
  /// response gets the numbers entered somewhere else.
  actionTaken String?   @db.Text
  /// When the action was taken. Separate from createdAt, which is when
  /// the row was typed: an operator recording last quarter's response
  /// this morning is the ordinary case, and conflating the two would
  /// date every response to the day of data entry.
  actionOn    DateTime?
  createdAt   DateTime  @default(now())

  spi Spi @relation(fields: [spiId], references: [id], onDelete: Cascade)

  // C-07 again, in the schema this time: a period appended twice is a
  // rate computed from a doubled denominator, and the alert level moves
  // for a reason that did not happen.
  @@unique([spiId, label])
  @@index([orgId])
  @@index([spiId])
}

model SyncReceipt {
  id       String @id @default(uuid())
  orgId    String
  clientId String

  entityType String
  op         String

  // Both nullable, and BOTH ARE NULL FOR AN ANONYMOUS REPORT.
  //
  // These columns are the ones that used to be written unconditionally.
  // syncReceipt.clientId and safetyReport.clientId hold the same value,
  // so a single join re-identified every anonymous reporter. Nulling
  // them is not a nicety; it is the difference between a confidential
  // reporting system and a list of who reported what.
  userId   String?
  deviceId String?

  // Keyed hash of the device, kept only for anonymous submissions so
  // repeat sends from one handset are still recognisable as duplicates
  // without the handset being identifiable from the row.
  deviceHash String?

  conflict   Boolean @default(false)
  resolution String?

  createdAt DateTime @default(now())

  org  Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Scoped to the org, not global. A globally unique clientId let any
  // authenticated caller probe whether an id existed in another
  // operator's tenancy.
  @@unique([orgId, clientId])
  @@index([orgId, createdAt])
}

model AuditLog {
  id         String  @id @default(uuid())
  seq        BigInt  @default(autoincrement())
  orgId      String
  userId     String?
  action     String
  entityType String
  entityId   String
  detail     Json?

  // The chain. `hash` commits to every column above plus prevHash and
  // createdAt — see auditMaterial() in apps/api/src/core.ts, which is
  // the single definition both the writer and the verifier use.
  prevHash String
  hash     String

  createdAt DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // ===================================================================
  // RESTRICT, not SetNull, and the difference is the whole control.
  //
  // The chain's hash commits to `userId` — see auditMaterial() in
  // apps/api/src/audit-material.ts. SetNull therefore let an ordinary
  // administrative act rewrite the hashed content of every row naming a
  // departing member of staff, and every one of those rows stopped
  // matching its own hash. Reproduced:
  //
  //   chain BEFORE offboarding: {"ok":true,"rowsChecked":3}
  //   chain AFTER  offboarding: {"ok":false,"contentAlteredAtSeq":"4"}
  //
  // An audit log that spontaneously reports itself altered is
  // indistinguishable, to the regulator reading it, from one that was —
  // which is the sentence audit-material.ts already carries about key
  // ordering, arriving here through a foreign key.
  //
  // So the row cannot be deleted while the log names it. `User.active`
  // already exists and is what offboarding is supposed to use; the
  // integration test alongside this asserts the refusal and that the
  // chain still verifies afterwards.
  //
  // SafetyReport.reporterId stays SetNull deliberately: a report must
  // survive its author leaving, and nothing hashes it.
  // ===================================================================
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orgId, seq])
}

// =====================================================================
// THE REST OF ANNEX 19.
//
// Everything above serves elements 2.1, 2.2, 3.1 and 3.2 — reporting,
// risk, indicators and change. The models below are the other eight,
// and they exist because /coverage has been telling operators for
// months that the product can score those elements and cannot do them.
//
// ONE SHAPE, REPEATED, BECAUSE THE ELEMENTS SHARE ONE. Almost every
// piece of SMS evidence an auditor asks for is: a versioned statement,
// approved by a named post on a date, distributed to people, with a
// record of who acknowledged it. That is not a coincidence — it is what
// "documented" means in a regulated system. So the models rhyme
// deliberately rather than each inventing its own vocabulary.
//
// WHAT IS NOT SHARED is what an auditor actually checks per element:
// a policy is signed by the accountable executive and nobody else; a
// finding has an owner and a verified closure; a training record
// expires. Those are columns, not a generic key-value bag, because a
// generic bag cannot be indexed, cannot be constrained, and cannot be
// queried for "what is overdue" — which is the only question anybody
// asks of this data.
//
// Every table is orgId-first, like the rest. Every write goes through
// the API and appends to the audit chain.
// =====================================================================

/// Element 1.1 — management commitment. The signed safety policy.
///
/// VERSIONED AND APPEND-ONLY. A safety policy that is edited in place
/// has no history, and the question an auditor asks is "what did it say
/// when the decision was taken". Superseding writes a new row; the old
/// one keeps its signature and its dates.
/// Regulation 13(3) of L.N. 32/2026 — the six things a service
/// provider's voluntary reporting system must DEFINE, and 13(2)'s
/// protection, held as the operator's own words.
///
/// ONE ROW PER OPERATOR, hence the unique orgId. This is not a log of
/// attempts; it is the current definition of the scheme, and a second
/// row would mean an operator whose voluntary system is defined twice
/// and differently — which is the thing an inspector would find.
///
/// EVERY FIELD IS NULLABLE, deliberately. An operator part-way through
/// defining its scheme has a real and common state, and forcing all six
/// at once would either block them from recording any of it or invite
/// placeholder text. What must never happen is the PRODUCT deciding an
/// undefined field is defined: unanswered() in packages/shared computes
/// which are still missing, and reports them as missing rather than
/// scoring them.
///
/// 13(2) IS PROSE, NOT A CHECKBOX. "Non-punitive and affording
/// protection to the sources" is a property the scheme must have, and a
/// tickbox saying so is a self-certification that looks like compliance
/// and evidences nothing. The operator states HOW.
model VoluntaryScheme {
  id           String   @id @default(uuid())
  orgId        String   @unique
  /// 13(3)(a) — the objective of the system.
  objective    String?  @db.Text
  /// 13(3)(b) — the sectors or areas it covers.
  scope        String?  @db.Text
  /// 13(3)(c) — who can report.
  whoMayReport String?  @db.Text
  /// 13(3)(d) — when to report.
  whenToReport String?  @db.Text
  /// 13(3)(e) — how reports are processed.
  howProcessed String?  @db.Text
  /// 13(3)(f) — the manager to be contacted. A POST, not a person, so
  /// the scheme survives the individual leaving.
  contactPost  String?  @db.Text
  /// 13(2) — how the scheme is non-punitive and protects its sources.
  protection   String?  @db.Text
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

enum ChangeTrigger {
  FLEET
  ROUTE_OR_NETWORK
  ORGANISATION
  KEY_PERSONNEL
  EQUIPMENT_OR_SYSTEM
  PROCEDURE
  OTHER
}

enum ChangeStatus {
  DRAFT
  ASSESSED
  APPROVED
  IN_EFFECT
  REVIEWED
}

/// Element 3.2 — the management of change, held by the organisation.
///
/// The element's evidence definition is unusually precise: "a change
/// assessment for the most recent significant change, DATED BEFORE IT
/// HAPPENED". An assessment written after the fleet arrived is a
/// justification, and the difference between the two is the whole
/// element. Both dates are therefore stored and neither is derived —
/// `assessedOn` is when the thinking was done, `effectiveFrom` is when
/// the change takes effect, and their ORDER is what an inspector reads.
///
/// THE RISK POSITION IS STORED, for the same reason RiskAssessment's
/// is: an assessment is a decision taken on a date under the matrix as
/// it stood, and recomputing it if the scale is ever revised would
/// rewrite a decision somebody approved. Computed on write from the
/// same risk.ts the register and /methodology use.
///
/// APPROVAL IS A SEPARATE ACT from assessment, and separately
/// permissioned — moc.create writes it, moc.approve signs it. A change
/// its own author can approve is not routed.
model ChangeAssessment {
  id            String        @id @default(uuid())
  orgId         String
  title         String
  description   String        @db.Text
  trigger       ChangeTrigger
  /// When the thinking was done.
  assessedOn    DateTime
  /// When the change takes, or took, effect. Nullable while a change is
  /// still being planned — a date nobody has set is not the same as a
  /// change that happened today.
  effectiveFrom DateTime?

  severity     Severity
  likelihood   Likelihood
  score        Int
  tolerability Tolerability
  controls     String?      @db.Text

  residualSeverity     Severity?
  residualLikelihood   Likelihood?
  residualScore        Int?
  residualTolerability Tolerability?

  approvedById String?
  approvedAt   DateTime?

  /// The half operators most often skip: whether the change did what it
  /// was expected to. Element 3.2 is not discharged by assessing.
  reviewDueOn DateTime?
  reviewedOn  DateTime?
  reviewNotes String?   @db.Text

  status    ChangeStatus @default(DRAFT)
  updatedAt DateTime     @updatedAt
  createdAt DateTime     @default(now())

  org        Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("changeApprover", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([orgId, status])
  @@index([orgId, effectiveFrom])
}

model SafetyPolicy {
  id            String    @id @default(uuid())
  orgId         String
  version       Int
  statement     String    @db.Text
  /// Null until the accountable executive signs it. An unsigned policy
  /// is a draft, and element 1.1 is about the signature.
  signedById    String?
  signedOn      DateTime?
  effectiveFrom DateTime?
  supersededOn  DateTime?
  createdAt     DateTime  @default(now())

  org      Org                     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  signedBy User?                   @relation("policySignatory", fields: [signedById], references: [id], onDelete: Restrict)
  reads    PolicyAcknowledgement[]

  @@unique([orgId, version])
  @@index([orgId, supersededOn])
}

/// Who has read the policy. Element 1.1's evidence that it reached
/// anybody, which is the half most operators cannot produce.
model PolicyAcknowledgement {
  id             String   @id @default(uuid())
  orgId          String
  policyId       String
  userId         String
  acknowledgedAt DateTime @default(now())

  org    Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  policy SafetyPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([policyId, userId])
  @@index([orgId, acknowledgedAt])
}

/// Element 1.2 — safety accountability and responsibilities.
///
/// A POST, NOT A PERSON. The question is whether each accountability has
/// an owner in the structure; who currently holds the post is a separate
/// fact that changes more often, and lives on Appointment below.
model Accountability {
  id             String   @id @default(uuid())
  orgId          String
  post           String
  responsibility String   @db.Text
  /// The Annex 19 element this accountability serves, so the matrix can
  /// be read against the framework rather than as a list.
  elementId      String?
  createdAt      DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, post])
}

/// Element 1.3 — appointment of key safety personnel.
model Appointment {
  id          String    @id @default(uuid())
  orgId       String
  post        String
  userId      String
  appointedOn DateTime
  /// The appointment letter's own reference, so the record points at the
  /// document rather than replacing it.
  letterRef   String?
  endedOn     DateTime?
  createdAt   DateTime  @default(now())

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation("appointee", fields: [userId], references: [id], onDelete: Restrict)

  @@index([orgId, post, endedOn])
}

/// Element 1.4 — emergency response planning, and the exercises that
/// are the only evidence a plan works.
model EmergencyExercise {
  id           String   @id @default(uuid())
  orgId        String
  scenario     String   @db.Text
  heldOn       DateTime
  /// Who else took part. An ERP that connects to nobody is a document.
  participants String   @db.Text
  findings     String   @db.Text
  planUpdated  Boolean  @default(false)
  createdAt    DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, heldOn])
}

/// Element 1.5 — SMS documentation, under control.
model ControlledDocument {
  id           String    @id @default(uuid())
  orgId        String
  title        String
  reference    String
  version      String
  approvedById String?
  approvedOn   DateTime?
  reviewBy     DateTime?
  supersededOn DateTime?
  createdAt    DateTime  @default(now())

  org        Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("documentApprover", fields: [approvedById], references: [id], onDelete: Restrict)

  @@unique([orgId, reference, version])
  @@index([orgId, reviewBy])
}

/// Element 3.3 — continuous improvement. An internal SMS audit finding,
/// and the corrective action that closes it.
///
/// CLOSURE IS NOT THE SAME AS VERIFICATION, and conflating them is how
/// an operator ends up with a closed finding that never worked. Both
/// dates are here, and the API refuses to verify what is not closed.
model AuditFinding {
  id               String          @id @default(uuid())
  orgId            String
  auditRef         String
  finding          String          @db.Text
  /// The element the finding sits against, so an audit programme can be
  /// shown to cover the framework rather than whatever was noticed.
  elementId        String?
  severity         FindingSeverity @default(OBSERVATION)
  ownerPost        String
  dueBy            DateTime?
  correctiveAction String?         @db.Text
  closedOn         DateTime?
  verifiedById     String?
  verifiedOn       DateTime?
  createdAt        DateTime        @default(now())

  org        Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("findingVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)

  @@index([orgId, closedOn, dueBy])
  @@index([orgId, elementId])
}

enum FindingSeverity {
  NONCONFORMITY
  OBSERVATION
  IMPROVEMENT
}

/// Element 4.1 — training and education.
///
/// EXPIRY IS THE POINT. A training matrix nobody can query for "what
/// lapses this quarter" is a spreadsheet, and the finding an auditor
/// writes is about the expired row rather than about the matrix.
model TrainingRecord {
  id          String    @id @default(uuid())
  orgId       String
  userId      String
  course      String
  completedOn DateTime
  expiresOn   DateTime?
  createdAt   DateTime  @default(now())

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation("trainee", fields: [userId], references: [id], onDelete: Restrict)

  @@index([orgId, expiresOn])
  @@index([orgId, userId])
}

/// Element 4.2 — safety communication, in both directions.
///
/// A bulletin published to the organisation, and — the half that
/// actually decides whether people keep reporting — what the reporter
/// was told happened as a result of theirs.
model SafetyCommunication {
  id            String   @id @default(uuid())
  orgId         String
  title         String
  body          String   @db.Text
  publishedOn   DateTime @default(now())
  publishedById String?
  /// Set when this is feedback ABOUT a specific report rather than a
  /// general bulletin. Never set for an anonymous report: there is
  /// nobody to tell, and a row joining feedback to an anonymous report
  /// is the re-identification the sync path was fixed to prevent.
  reportId      String?

  org         Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  publishedBy User?         @relation("communicator", fields: [publishedById], references: [id], onDelete: Restrict)
  report      SafetyReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([orgId, publishedOn])
}
