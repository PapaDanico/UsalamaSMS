// =====================================================================
// UsalamaSMS — data model
//
// Every tenant-owned table carries orgId and is indexed on it first.
// Multi-tenancy here is not a feature, it is the security boundary: two
// operators who compete on the same routes share this database, and a
// query that forgets orgId is a data breach between competitors.
//
// Connection URL lives in prisma.config.ts (Prisma 7), not here.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer accepts `url` here — the connection lives in
// prisma.config.ts, and the client takes an adapter. The schema had both,
// which is not a style disagreement: `prisma generate` refuses to run,
// so the client was never generated, so `tsc` could not resolve
// PrismaClient, so twelve of the thirteen type errors in this repository
// were one line in this file.
datasource db {
  provider = "postgresql"
}

enum Role {
  FRONTLINE
  SAFETY_OFFICER
  SAFETY_MANAGER
  INVESTIGATOR
  KEY_MANAGEMENT
  ACCOUNTABLE_EXECUTIVE
  REGULATOR_INSPECTOR
  SYSTEM_ADMIN

  /// THE VENDOR, NOT THE OPERATOR, and the only role in this enum that
  /// is not somebody in an aviation organisation.
  ///
  /// SYSTEM_ADMIN administers ONE tenant — it is the operator's own
  /// account administrator. PLATFORM_ADMIN provisions tenants and
  /// confirms what they have paid for, across all of them, and holds
  /// NO safety permission whatsoever: not a narrative, not a hazard,
  /// not an audit log, not an export. See permissions.ts, where a test
  /// asserts that its set is disjoint from NARRATIVE_PERMISSIONS.
  ///
  /// The distinction is the product's own promise. An operator is
  /// buying a place to put the thing their people are most reluctant
  /// to write down; a vendor account that could read it would make the
  /// confidentiality claim false no matter what the privacy page says.
  PLATFORM_ADMIN
}

enum ReportType {
  MOR
  VCR
  HAZARD
  SUGGESTION
  NEAR_MISS
  FATIGUE
}

enum ReportState {
  SUBMITTED
  TRIAGED
  UNDER_INVESTIGATION
  ACTIONS_OPEN
  CLOSED
}

enum Severity {
  A_CATASTROPHIC
  B_HAZARDOUS
  C_MAJOR
  D_MINOR
  E_NEGLIGIBLE
}

enum Likelihood {
  FREQUENT
  OCCASIONAL
  REMOTE
  IMPROBABLE
  EXTREMELY_IMPROBABLE
}

enum Tolerability {
  INTOLERABLE
  TOLERABLE
  ACCEPTABLE
}

enum FlightPhase {
  STANDING
  PUSHBACK
  TAXI
  TAKEOFF
  INITIAL_CLIMB
  CLIMB
  CRUISE
  DESCENT
  APPROACH
  LANDING
  LANDING_ROLL
  GO_AROUND
  GROUND_HANDLING
  MAINTENANCE
}

// A reporting obligation follows the STATE OF REGISTRY. This product
// maintains one State's standard properly — Kenya — and offers ICAO's
// baseline for every other: Annex 13 requires notification with a
// minimum of delay and names no period, so no deadline is computed for
// it.
//
// UG, TZ and RW were removed because all three carried the EU's 72
// hours as an "ICAO-common" default, and there is no such default. The
// EU row itself was then removed for scope rather than accuracy —
// nothing here is built for an EU-registered operator, and a
// jurisdiction on offer is a claim to know its obligations. See
// regulations.ts.
//
// EAC member states have been re-added as PROVISIONAL rows — no fixed
// reporting period, ICAO Annex 13 baseline applies until the primary
// instrument for each State is read and a period is confirmed.
enum Jurisdiction {
  ICAO
  KE
  UG
  TZ
  RW
  BI
  SS
  CD
  SO
}

model Org {
  id           String       @id @default(uuid())
  name         String
  // The regulator this operator answers to. Drives which reporting
  // obligation row applies — see packages/shared/src/regulations.ts.
  jurisdiction Jurisdiction @default(KE)
  aocNumber    String?
  createdAt    DateTime     @default(now())

  /// HOW MANY AIRCRAFT, AND THEREFORE WHAT IT COSTS.
  ///
  /// The BAND IS NOT STORED. pricing.ts derives it from this number, so
  /// an operator that buys a fourth aircraft moves band by changing one
  /// fact rather than by somebody remembering to change two. A stored
  /// band is a value that can disagree with the fleet it was computed
  /// from, and then the invoice and the product disagree in front of a
  /// customer.
  ///
  /// NULLABLE, and that is deliberate rather than lazy: every Org that
  /// existed before this field did has no fleet size, and
  /// `billableBand` returns null for a missing one instead of quietly
  /// invoicing the cheapest band off an absent fact.
  fleetSize Int?

  /// WHAT THE OPERATOR ACTUALLY FLIES, AND FROM WHERE.
  ///
  /// fleetSize is a number and answers what it costs. These answer what
  /// the safety office is looking at — and they are the denominators
  /// every rate this product computes has been missing. "Four runway
  /// excursions" against an operator flying two Caravans out of Wilson
  /// is a different fact from four against a mixed turboprop fleet
  /// across the northern network, and until this existed nothing could
  /// tell the two apart.
  ///
  /// CODES FROM THE SHARED VOCABULARIES, not free text: aircraft types
  /// from AIRCRAFT_TYPES, bases from AERODROMES, operations from
  /// OPERATION_TYPES in adrep.ts — the same list the triage panel codes
  /// an occurrence's type of operation against, so an operator's
  /// declared profile and its coded occurrences group together instead
  /// of being two vocabularies for one fact.
  ///
  /// EMPTY IS NOT UNKNOWN, same as everywhere else in this schema. An
  /// operator that skipped the question has an empty array and is
  /// visibly un-profiled; there is no sentinel that would count as an
  /// answer nobody gave.
  fleetTypes     String[]
  bases          String[]
  operationTypes String[]

  /// The two dates a subscription is computed from — see
  /// packages/shared/src/subscription.ts. TRIAL, ACTIVE, GRACE and
  /// LAPSED are derived from these on every read and never written
  /// down, so no failed webhook can leave an operator in a state that
  /// disagrees with what they have actually paid for.
  ///
  /// `paidThrough` is the ONLY field a payment rail ever writes, which
  /// is what stops M-Pesa, a card processor and a bank transfer from
  /// becoming three different state machines.
  trialEndsOn DateTime?
  paidThrough DateTime?

  users     User[]
  reports   SafetyReport[]
  hazards   Hazard[]
  auditLogs AuditLog[]
  receipts  SyncReceipt[]
  spis      Spi[]

  // The other eight Annex 19 elements.
  policies          SafetyPolicy[]
  voluntaryScheme   VoluntaryScheme?
  policyReads       PolicyAcknowledgement[]
  accountabilities  Accountability[]
  appointments      Appointment[]
  exercises         EmergencyExercise[]
  emergencyContacts EmergencyContact[]
  documents         ControlledDocument[]
  findings          AuditFinding[]
  training          TrainingRecord[]
  communications    SafetyCommunication[]
  changes           ChangeAssessment[]
  setiAssessments   SetiAssessment[]
  documentReads     DocumentAcknowledgement[]
  reportMoves       ReportTransition[]
  actions           CorrectiveAction[]
  config            OrgConfig?
  fatigueLimit      FatigueLimit?
  attachments       ReportAttachment[]
}

model User {
  id           String   @id @default(uuid())
  orgId        String
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(FRONTLINE)
  mfaSecret    String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  org      Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  reports  SafetyReport[]
  tokens   RefreshToken[]
  receipts SyncReceipt[]
  audits   AuditLog[]
  resets   PasswordReset[]

  // Named relations, because a user can appear against one table in
  // more than one role and Prisma cannot guess which is which.
  policiesSigned    SafetyPolicy[]            @relation("policySignatory")
  policyReads       PolicyAcknowledgement[]
  appointments      Appointment[]             @relation("appointee")
  documentsApproved ControlledDocument[]      @relation("documentApprover")
  findingsVerified  AuditFinding[]            @relation("findingVerifier")
  training          TrainingRecord[]          @relation("trainee")
  authorityNotices  SafetyReport[]            @relation("authorityNotifier")
  reportsRetracted  SafetyReport[]            @relation("reportRetractor")
  communications    SafetyCommunication[]     @relation("communicator")
  changesApproved   ChangeAssessment[]        @relation("changeApprover")
  documentReads     DocumentAcknowledgement[]
  reportMoves       ReportTransition[]
  actionsCompleted  CorrectiveAction[]        @relation("actionCompleter")
  actionsVerified   CorrectiveAction[]        @relation("actionVerifier")
  contactsVerified  EmergencyContact[]        @relation("contactVerifier")
  setiAssessments   SetiAssessment[]          @relation("setiAssessor")

  @@index([orgId, role])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

/// A live password-reset link, stored the way a credential has to be.
///
/// THE TOKEN IS NOT IN THIS TABLE. `tokenHash` holds an HMAC of it under
/// the server's own signing secret, exactly as RefreshToken does — the
/// value that goes in the email exists in this system for the length of
/// one request and is never written down. A dump of this table restores
/// nobody's account.
///
/// `usedAt` rather than a delete, because "this link was spent at 14:02"
/// is the fact an operator needs when asking why a colleague was signed
/// out, and a deleted row cannot answer it. Consumption is a conditional
/// UPDATE on `usedAt IS NULL`, which is what makes two clicks on the same
/// link a race exactly one of them wins — the lesson the refresh route
/// records at length.
model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Issuing a new link invalidates the outstanding ones for that user,
  /// which is a sweep over exactly this index.
  @@index([userId, usedAt])
}

model SafetyReport {
  id       String @id @default(uuid())
  orgId    String
  // Client-generated idempotency key for offline submission.
  // Scoped to the org below, not globally unique. See the same note on
  // SyncReceipt: clientId is generated on the device, so a global
  // constraint let one operator's id collide with another's — which
  // raised an uncaught P2002 inside the batch loop, returned 500 for
  // the whole batch, and left the device retrying into it forever. It
  // also answered "does this id exist in another tenancy?" through the
  // status code. The receipt table was fixed; this one was missed.
  clientId String

  type      ReportType
  state     ReportState @default(SUBMITTED)
  title     String
  narrative String      @db.Text

  /// What the reporter thinks should be done about it.
  ///
  /// From the operator's own hazard report form, where "Reporter's
  /// Recommendations" sits above the safety office's analysis. The
  /// person who saw the hazard usually knows the fix, and this is the
  /// cheapest safety intelligence in the system.
  ///
  /// De-identified with the narrative, never separately: a recommendation
  /// can identify its author as readily as the account can.
  reporterRecommendation String? @db.Text

  occurredAt   DateTime?
  // When the reporting obligation began running for this organisation.
  // NOT the same as occurredAt, and the distinction is the difference
  // between meeting a 24-hour deadline and missing it — an engineer who
  // discovers a Friday defect on Monday reports from Monday.
  awareAt      DateTime?
  jurisdiction Jurisdiction @default(KE)

  // Both now hold a code from packages/shared/src/taxonomy.ts rather than
  // whatever someone typed. "HKJK", "JKIA" and "Nairobi" were three
  // aerodromes to a GROUP BY, which made every safety-intelligence
  // question unanswerable. The dropdowns keep a free-text escape, so
  // these are still nullable strings rather than enums — a vocabulary
  // with no way out puts the real answer in the narrative instead.
  location     String?
  aircraftType String?
  phase        FlightPhase?
  hrcTags      String[]

  // ---------------- What the State files it under ----------------
  //
  // ICAO occurrence categories, from the CAST/ICAO Common Taxonomy
  // Team. This product's six report TYPES describe what kind of report
  // arrived; they are not what a State files. ADREP — maintained in
  // detail by EASA as the ECCAIRS taxonomy — is, and an operator whose
  // reports carry no code hands its authority data somebody re-codes by
  // hand.
  //
  // AN ARRAY, AND THAT IS THE TAXONOMY'S OWN RULE RATHER THAN A
  // CONVENIENCE. CICTT's usage notes are explicit that a runway
  // excursion which became a loss of control is coded as BOTH, because
  // the taxonomy exists for accident prevention and every pertinent
  // element should be recorded. One code per report would discard the
  // second half of exactly the occurrences worth learning from.
  //
  // WRITTEN BY THE SAFETY OFFICE, NOT BY THE REPORTER. It is set
  // through the disposition, which is the moment somebody trained
  // classifies the occurrence for onward filing. A reporter at a strip
  // has not made that determination and must not be made to — the same
  // reasoning that keeps the Annex 13 occurrence class off the form.
  //
  // NO FOREIGN KEY, DELIBERATELY. The code list this product carries is
  // incomplete by admission, so an operator sending a legitimate CICTT
  // code the product has not got yet is a gap in the product, not an
  // error in the report. The occurrence is recorded and the gap is
  // reported — see unrecognised() in packages/shared/src/cictt.ts.
  cicttCodes String[]

  // ---- The five things a State files beside the category ----
  //
  // The occurrence category says WHAT HAPPENED. These say how badly it
  // hurt somebody, what it did to the aircraft, whether it was dark,
  // whether the crew could see, and what kind of flight it was. Without
  // them "eleven runway excursions" is a number nobody can act on; with
  // them it is "nine of them at night, seven on non-scheduled sectors,
  // two with substantial damage", which has a control attached.
  //
  // NULLABLE, AND NULL IS NOT "UNKNOWN". Null means nobody has coded it
  // yet. Every vocabulary carries an explicit UNKNOWN for "somebody
  // trained read the narrative and could not establish it". Conflating
  // them reports an un-triaged backlog as a determination.
  //
  // ONE VALUE EACH, unlike cicttCodes — an occurrence has one worst
  // injury and one light condition. See packages/shared/src/adrep.ts,
  // which also records that none of these vocabularies has been read
  // against its primary instrument.
  //
  // NOT ENUMS, for the reason the CICTT column is not a foreign key: a
  // vocabulary this product admits is incomplete should not be able to
  // reject a value at the database layer that the taxonomy accepts. The
  // route validates against the shared list, so the guarantee holds
  // where it can be changed without a migration.
  injuryLevel    String?
  aircraftDamage String?
  lightCondition String?
  metCondition   String?
  operationType  String?

  // ------------------------ Confidentiality ------------------------
  isAnonymous           Boolean   @default(false)
  // Null when anonymous, and null again — permanently — once a VCR has
  // been through de-identification. Hard removal, never reversible
  // encryption: a key that exists is a key that can be compelled.
  reporterId            String?
  isDeIdentified        Boolean   @default(false)
  deIdentifiedAt        DateTime?
  deIdentifiedNarrative String?   @db.Text

  /// WHEN THE AUTHORITY WAS NOTIFIED, AND WHO SAYS SO.
  ///
  /// The product computed reporting deadlines from the day it shipped
  /// and had nowhere to record that one had been MET. `deadlineStatus`
  /// takes a `submittedAt` meaning "discharged" and was called from
  /// nowhere in the API, so every occurrence's window simply passed —
  /// and a notified report was indistinguishable from a forgotten one.
  ///
  /// IT IS A CLAIM ABOUT AN ACT OUTSIDE THIS SYSTEM. L.N. 32 expects
  /// the urgent classes by telephone; nothing here places the call. So
  /// this records WHEN the operator says they notified, WHO recorded
  /// that, and the authority's own reference where one was given —
  /// which is the part that makes it evidence rather than an assertion.
  ///
  /// NULLABLE FOREVER. Most reports are not occurrences and owe nobody
  /// a notification; a default would turn "not applicable" into "done".
  reportedToAuthorityAt   DateTime?
  reportedToAuthorityById String?
  /// The authority's acknowledgement, as they issued it. Never sent in
  /// a digest — see packages/shared/src/digest.ts on what leaves the
  /// access control.
  authorityReference      String?

  /// ---------------- Retraction — a tombstone, never a delete --------
  ///
  /// A DEVICE'S DELETE IS A LOCAL RETRACTION; THE SERVER'S ANSWER IS A
  /// STATE. A hard delete of a safety report destroys evidence an
  /// auditor is entitled to and breaks the append-only chain that makes
  /// the rest of the record worth anything — the same reasoning that
  /// makes `reporterId` SetNull rather than Cascade when a person is
  /// offboarded. So the row stays and stops counting.
  ///
  /// WHAT THIS IS FOR, and what it is NOT. A reporter who filed the
  /// same hazard twice, or filed against the wrong aircraft and refiled,
  /// needs the first one to stop appearing. That is a correction to the
  /// record. It is NOT a way to make an occurrence go away: the row
  /// remains, the audit entry remains, who retracted it and when are
  /// recorded, and THE EXPORT STILL CARRIES IT — deliberately, because
  /// an export that hid retracted reports would turn this feature into
  /// a way to remove an inconvenient occurrence from what a regulator
  /// sees. Every other read path drops them; that one does not, and
  /// scripts/check-retraction.mjs makes each query say which it is.
  ///
  /// NULLABLE FOREVER, and every list query must exclude it. The way
  /// this goes wrong is one query somebody forgets, which is why
  /// tests/retraction.test.ts asserts over the read paths rather than
  /// over a list of them.
  // ===================================================================
  // WHAT A FATIGUE REPORT CARRIES THAT NO OTHER REPORT DOES.
  //
  // `FATIGUE` was in the ReportType enum from the first migration and
  // nothing ever read it, so a crew member too tired to fly safely
  // filed a row indistinguishable from a bird strike. These are the
  // facts that make such a report analysable rather than anecdotal, and
  // every one is NULLABLE because they are asked only when the type is
  // FATIGUE and because a reporter who does not remember their rest
  // must be able to file anyway — a form that refuses an incomplete
  // fatigue report is a form that converts a report into silence.
  //
  // LOCAL HOURS, not timestamps. The window of circadian low is a
  // property of the reporter's body clock, so what matters is the hour
  // it felt like to them. A UTC timestamp would need an acclimatisation
  // model this product does not have and should not guess at.
  // ===================================================================
  fatigueFlightTimeHours Float?
  fatigueDutyHours       Float?
  fatigueRestBeforeHours Float?
  fatigueSectors         Int?
  fatigueSleepPrior24    Float?
  fatigueStartLocalHour  Int?
  fatigueEndLocalHour    Int?
  /// Samn-Perelli, 1..7. See packages/shared/src/fatigue.ts for the scale.
  fatigueSamnPerelli     Int?

  retractedAt     DateTime?
  /// Null for an anonymous report, exactly as reporterId is. A
  /// retraction must not become the identifier the filing refused to
  /// store — see the receipt in routes.sync.ts.
  retractedById   String?
  /// The reporter's own words for why, capped and optional. Not
  /// required: a required reason on a correction produces "duplicate"
  /// typed a hundred times, which tells the next reader nothing.
  retractedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org         Org                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  reporter    User?                 @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  reportedBy  User?                 @relation("authorityNotifier", fields: [reportedToAuthorityById], references: [id], onDelete: Restrict)
  retractedBy User?                 @relation("reportRetractor", fields: [retractedById], references: [id], onDelete: SetNull)
  feedback    SafetyCommunication[]
  hazards     Hazard[]
  attachments ReportAttachment[]
  transitions ReportTransition[]
  actions     CorrectiveAction[]

  // DELIBERATELY NOT A COLUMN: regulatorDeadline.
  //
  // Charter rule 6 — regulatory status is computed from today's date,
  // never stored. A stored deadline survives a correction to occurredAt,
  // survives a correction to awareAt, and survives the regulator
  // changing the rule; all three leave the operator holding a number the
  // product is confident about and the authority disagrees with.
  // Computed at read time by reportingDeadline() from jurisdiction +
  // awareAt. If you are about to add this column, read that module first.

  @@unique([orgId, clientId])
  /// Declared here as well as in the migration. Without it the next
  /// `prisma migrate dev` sees an index the schema does not describe
  /// and generates a DROP — the digest's deadline query loses its index
  /// silently, and nothing fails until the table is large.
  @@index([orgId, reportedToAuthorityAt])
  /// EVERY list query gains `retractedAt: null`, so the index that
  /// serves the queue has to carry it or the exclusion costs a scan on
  /// the one screen a safety office keeps open.
  @@index([orgId, retractedAt])
  @@index([orgId, state, createdAt])
  @@index([orgId, type, occurredAt])
  // The aggregation this taxonomy exists to make possible.
  @@index([orgId, location, phase])
  @@index([reporterId], map: "idx_safetyreport_reporterid")
  @@index([reportedToAuthorityById], map: "idx_safetyreport_reportedtoauthoritybyid")
  @@index([retractedById], map: "idx_safetyreport_retractedbyid")
}

/// What happened to a report, one row per move.
///
/// THE GAP THIS CLOSES. ReportState has five values and four of them
/// were unreachable: nothing wrote the column. Every report ever filed
/// was SUBMITTED, permanently — a queue that only grows, which element
/// 2.1's own evidence line ("a report rate that is trending") cannot be
/// satisfied by.
///
/// THE HISTORY IS THE RECORD, not a closedAt column. A column answers
/// "when"; an inspector asks by whom, from what, and what was done. It
/// also makes time-to-closure derivable rather than stored — and
/// derivable from the FIRST closure specifically, which a column
/// overwritten on reopening could not answer at all.
///
/// SafetyReport.state IS STILL STORED, and that is not a charter rule 6
/// violation: the state is not derived from anything, it IS the fact,
/// and the triage queue's @@index([orgId, state, createdAt]) is what
/// keeps that screen from re-deriving five states per row on every
/// render. The route writes both inside one transaction and
/// tests/integration assert they agree.
///
/// userId IS RESTRICT, like AuditLog and for the same reason: who moved
/// a report is part of the record, and an offboarded person having
/// triaged it remains true.
///
/// ROW SECURITY ON, NO POLICY, NOT FORCED.
model ReportTransition {
  id       String @id @default(uuid())
  orgId    String
  reportId String

  fromState ReportState
  toState   ReportState

  /// Required by the state machine for a closure or a reopening, and
  /// optional otherwise — see disposition.ts. Nullable here rather than
  /// defaulted to "", because "no note was required" and "a note was
  /// required and somebody typed nothing" are different facts and the
  /// second one must not be reachable.
  note String? @db.Text

  byUserId String
  at       DateTime @default(now())

  org    Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  report SafetyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  by     User         @relation(fields: [byUserId], references: [id], onDelete: Restrict)

  /// The order the history is read in, and the index the closure
  /// indicator aggregates over.
  @@index([orgId, reportId, at])
  @@index([orgId, toState, at])
  @@index([orgId], map: "idx_reporttransition_orgid")
  @@index([reportId], map: "idx_reporttransition_reportid")
  @@index([byUserId], map: "idx_reporttransition_byuserid")
}

/// A corrective or preventive action — the CAPA loop.
///
/// WHAT WAS MISSING. The product could record that something was DONE:
/// a note on a report's closure, a `correctiveAction` string on an
/// audit finding, `controls` on a register entry. What it could not do
/// was treat the action itself as an object with an owner, a date and a
/// verification. So "fit a guard to the fuel bowser by month end" lived
/// as prose inside whichever record mentioned it, invisible to any
/// question of the form "what is outstanding".
///
/// ONE TABLE, FOUR SOURCES, EXACTLY ONE SET. An action arising from a
/// report, a finding, a register entry or a change is the same kind of
/// object, and splitting it four ways would give an operator four lists
/// and no answer across the SMS. The "exactly one" is a CHECK
/// constraint in the migration, not a convention — a convention is what
/// a second developer does not know about.
///
/// NO STATUS COLUMN, DELIBERATELY. Charter rule 6, and here it is not a
/// nicety: a stored "OPEN" is still OPEN the day after the due date
/// passes, so the one state an operator needs — overdue — is the one a
/// stored status cannot produce without a nightly job this product does
/// not have. statusOf() in packages/shared/src/capa.ts derives it from
/// the dates on every read.
///
/// completedById AND verifiedById ARE BOTH RESTRICT, like the audit
/// chain. Who did the work and who checked it are part of the record,
/// and an offboarded person having done either remains true.
model CorrectiveAction {
  id    String @id @default(uuid())
  orgId String

  /// Exactly one of these four is set. See the CHECK in the migration.
  reportId  String?
  findingId String?
  riskId    String?
  changeId  String?

  action String @db.Text

  /// A post code with a free-text escape, matching the register: a
  /// small operator's real titles are not this product's enum, and
  /// refusing an unrecognised one pushes the answer into a name box.
  ownerPost String
  dueOn     DateTime?

  completedOn    DateTime?
  completedById  String?
  completionNote String?   @db.Text

  verifiedOn       DateTime?
  verifiedById     String?
  verificationNote String?   @db.Text

  /// Cancelling is a recorded decision, not a delete. An operator that
  /// decided against a control has made a safety decision, and the
  /// reason is the part an auditor asks for.
  cancelledOn     DateTime?
  cancelledReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org         Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  report      SafetyReport?     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  finding     AuditFinding?     @relation(fields: [findingId], references: [id], onDelete: Cascade)
  risk        RiskAssessment?   @relation(fields: [riskId], references: [id], onDelete: Cascade)
  change      ChangeAssessment? @relation(fields: [changeId], references: [id], onDelete: Cascade)
  completedBy User?             @relation("actionCompleter", fields: [completedById], references: [id], onDelete: Restrict)
  verifiedBy  User?             @relation("actionVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)

  /// The question this table exists to answer: what is outstanding, and
  /// what is late.
  @@index([orgId, dueOn, completedOn])
  @@index([orgId, reportId])
  @@index([orgId], map: "idx_correctiveaction_orgid")
  @@index([reportId], map: "idx_correctiveaction_reportid")
  @@index([changeId], map: "idx_correctiveaction_changeid")
  @@index([completedById], map: "idx_correctiveaction_completedbyid")
  @@index([findingId], map: "idx_correctiveaction_findingid")
  @@index([riskId], map: "idx_correctiveaction_riskid")
  @@index([verifiedById], map: "idx_correctiveaction_verifiedbyid")
}

model Hazard {
  id          String  @id @default(uuid())
  orgId       String
  reportId    String?
  title       String
  description String  @db.Text
  source      String

  /// HOW THIS HAZARD WAS FOUND, against ICAO's three methods.
  ///
  /// `source` above answers a different question — whether a hazard
  /// arrived on a report or somebody typed it — and collapses a
  /// workshop finding, an audit finding, an indicator trend and a
  /// change assessment into one value meaning "not a report". Annex 19
  /// asks for a formal process based on a COMBINATION of reactive,
  /// proactive and predictive methods, and that combination could not
  /// be evidenced from two values.
  ///
  /// NULLABLE ON PURPOSE. A hazard recorded before this column existed
  /// has an unknown method, not a proactive one. See
  /// packages/shared/src/discovery.ts: backfilling the unknowns would
  /// manufacture exactly the evidence an operator is asked to produce.
  discovery   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org         Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  report      SafetyReport?    @relation(fields: [reportId], references: [id], onDelete: SetNull)
  assessments RiskAssessment[]

  @@index([orgId, createdAt])
  @@index([reportId], map: "idx_hazard_reportid")
}

model RiskAssessment {
  id          String @id @default(uuid())
  orgId       String
  hazardId    String
  consequence String @db.Text

  severity     Severity
  likelihood   Likelihood
  // Stored because they are the assessment OF RECORD at a point in time
  // — unlike a regulatory deadline, which is a property of law and
  // changes underneath you. If the matrix is ever revised, historic
  // assessments must keep the classification they were accepted under;
  // recomputing them would rewrite decisions people signed.
  score        Int
  tolerability Tolerability

  alarpJustification String?   @db.Text
  acceptedById       String?
  acceptedAt         DateTime?

  // ------------------------------------------------------------------
  // THE STANDING REGISTER, which is a different artefact from a
  // one-off assessment and was living in a browser.
  //
  // An assessment answers "how bad is this". A register answers "what
  // are we doing about it, who owns it, and when do we look again" —
  // and it is the register an auditor asks for, because a hazard with
  // no owner and no review date has been assessed and not managed.
  // ------------------------------------------------------------------
  controls String? @db.Text

  // The residual position, AFTER the controls above. Stored for exactly
  // the reason the initial pair is: it is the assessment of record at a
  // point in time, and recomputing it if the matrix is ever revised
  // would rewrite a decision somebody signed.
  //
  // Nullable as a set: an entry assessed today and controlled next week
  // has an initial position and no residual one, and inventing a
  // residual equal to the initial would report a control that does not
  // exist.
  residualSeverity     Severity?
  residualLikelihood   Likelihood?
  residualScore        Int?
  residualTolerability Tolerability?

  owner    String?
  // The date the entry is next due to be looked at. A register whose
  // rows have no review date is a list, and the finding an auditor
  // writes is that nobody was going to look again.
  reviewBy DateTime?
  status   RiskStatus @default(OPEN)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  hazard  Hazard             @relation(fields: [hazardId], references: [id], onDelete: Cascade)
  actions CorrectiveAction[]

  @@index([orgId, tolerability])
  // The two queries a safety office actually runs against a register:
  // what is open, and what is due.
  @@index([orgId, status])
  @@index([orgId, reviewBy])
  @@index([hazardId], map: "idx_riskassessment_hazardid")
}

enum RiskStatus {
  OPEN
  MITIGATED
  ACCEPTED
  CLOSED
}

model Spi {
  id           String   @id @default(uuid())
  orgId        String
  name         String
  // A safety performance indicator, in the shape the product actually
  // computes with. Annex 19 Amendment 2 raises these from good practice
  // to the substance of performance-based oversight, and regulation
  // 9(5) of Kenya's L.N. 32/2026 requires an SMS to HAVE indicators and
  // targets "acceptable to the Authority" — which a figure held in one
  // browser is not.
  //
  // WHAT CHANGED AND WHY. This model used to carry `unit`, `target` and
  // `alertLevel` and nothing else, and no code path ever read or wrote
  // it. Meanwhile the working model — kind, exposure basis, direction,
  // owner, and the periods everything is computed from — lived in
  // localStorage. The table was a guess at a feature that had since
  // been designed somewhere else.
  //
  // `alertLevel` IS GONE, deliberately. It is derived: alertLevels() in
  // packages/shared/src/spi.ts computes it from the series, and a
  // stored alert level is the same defect as a stored deadline —
  // correct on the day it was written and silently wrong after the next
  // period lands. Charter rule 6.
  kind         String
  // What the exposure counts, in the operator's words: sectors, hours,
  // movements, turnarounds.
  exposureUnit String
  // Rate basis: events per this many units of exposure.
  per          Float
  direction    String
  // The target, as a rate on the same basis. Optional because an
  // operator may be measuring before it is ready to commit to a figure,
  // and a required target is how indicators go untracked.
  target       Float?
  owner        String
  /// WHICH NATIONAL HIGH-RISK CATEGORY THIS INDICATOR BEARS ON, if any.
  ///
  /// Amendment 2 makes the link between an operator's indicators and
  /// the State's safety plan the substance of performance-based
  /// oversight rather than a courtesy. Kenya's NASP names six HRCs and
  /// lists the indicators it counts under each; an operator filing a
  /// number that lands in the same row as the national one can be read
  /// side by side with it, and one that invents its own measure cannot.
  ///
  /// NULLABLE, AND IT STAYS NULLABLE. An operator's indicators are
  /// theirs to choose — nothing in Kenya's plan is a requirement placed
  /// on them, and `NASP_CAVEAT` says so on the screen. A required
  /// column here would be this product inventing an obligation the
  /// State did not make, and would force every existing indicator to
  /// claim a category somebody never picked.
  ///
  /// A CODE FROM `HRC_CATEGORIES`, not free text, so the rollup cannot
  /// be defeated by spelling. Not an enum in the database: the list is
  /// declared once in taxonomy.ts and an enum here would be a second
  /// copy that drifts — which is exactly how `LOC_I` and the plan's
  /// `LOC-I` came to disagree.
  hrc          String?
  // =====================================================================
  // THE SUBMISSION HALF — Appendix II of CAA-AC-SMS009, read against
  // the document on 18 August 2026.
  //
  // §7.6.3: an operator submits each indicator to the Authority on
  // form AC-SMS009, and the Authority answers with an acceptance
  // letter. THE FORM ASKS FOR NO NUMBERS — no target, no alert level,
  // no period. It registers what the indicator IS: its description,
  // rationale, limitations, terms, formula and data custody. This
  // model held the arithmetic half and none of that, so the product
  // could compute an indicator the operator could not submit.
  //
  // ALL NULLABLE, deliberately. The form is filled over time and the
  // screen names what is still blank (`appendixTwoGaps` in
  // packages/shared/src/spi.ts); a required column would refuse the
  // indicator until the paperwork was done, which is how numbers end
  // up kept in a spreadsheet instead.
  //
  // `indicatorType` IS THE OPERATOR'S ANSWER, NEVER DERIVED. Field 3
  // asks activity-related (leading) or outcome-related (lagging) —
  // a different axis from `kind`, which is how RARE the events are.
  // A LOWER_CONSEQUENCE indicator splits both ways, so a derivation
  // would file leading indicators as lagging for a whole submission.
  // "ACTIVITY" | "OUTCOME", validated in the route against the list
  // in packages/shared/src/spi.ts — not a database enum, for the
  // reason `hrc` above gives: a second copy drifts.
  areaOfOperations  String?
  description       String?
  indicatorType     String?
  rationale         String?
  limitations       String?
  definitionOfTerms String?
  dataSets          String?
  dataProvider      String?
  dataCustodian     String?
  // Part E is the AUTHORITY'S box. These record what the acceptance
  // letter said, as transcribed by the operator — the product does
  // not submit and does not claim to (the same line icaas.ts draws).
  // `acceptance` is "ACCEPTED" | "NOT_ACCEPTED", null until a letter
  // exists; `submittedOn` is when the operator filed the form.
  submittedOn  DateTime?
  acceptance   String?
  acceptedOn   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org     Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  periods SpiPeriod[]

  // One indicator per name per operator. Two indicators called "Runway
  // excursions" with different series is a measurement nobody can act
  // on.
  @@unique([orgId, name])
  @@index([orgId])
}

model SpiPeriod {
  id          String    @id @default(uuid())
  // Denormalised onto the period as well as the indicator, because
  // every query in this API is scoped by orgId first and a join is not
  // a tenancy boundary.
  orgId       String
  spiId       String
  // "2026-Q1", "March" — whatever the operator's cadence is called.
  label       String
  events      Int
  exposure    Float
  /// Element 3.1's own evidence definition asks for "a record of what
  /// happened the last time one was crossed". This is that record,
  /// attached to the PERIOD rather than to an alert level — the level
  /// is derived by alertLevels() on every read and is deliberately not
  /// stored, so hanging the action off it would either require storing
  /// it or leave the note orphaned the moment the series moved.
  ///
  /// Nullable, and not required when a level is crossed. A product that
  /// refuses to record the numbers until somebody has written the
  /// response gets the numbers entered somewhere else.
  actionTaken String?   @db.Text
  /// When the action was taken. Separate from createdAt, which is when
  /// the row was typed: an operator recording last quarter's response
  /// this morning is the ordinary case, and conflating the two would
  /// date every response to the day of data entry.
  actionOn    DateTime?
  createdAt   DateTime  @default(now())

  spi Spi @relation(fields: [spiId], references: [id], onDelete: Cascade)

  // C-07 again, in the schema this time: a period appended twice is a
  // rate computed from a doubled denominator, and the alert level moves
  // for a reason that did not happen.
  @@unique([spiId, label])
  @@index([orgId])
  @@index([spiId])
}

model SyncReceipt {
  id       String @id @default(uuid())
  orgId    String
  clientId String

  entityType String
  op         String

  // Both nullable, and BOTH ARE NULL FOR AN ANONYMOUS REPORT.
  //
  // These columns are the ones that used to be written unconditionally.
  // syncReceipt.clientId and safetyReport.clientId hold the same value,
  // so a single join re-identified every anonymous reporter. Nulling
  // them is not a nicety; it is the difference between a confidential
  // reporting system and a list of who reported what.
  userId   String?
  deviceId String?

  // THERE IS NO deviceHash, AND ITS ABSENCE IS THE POINT.
  //
  // This column held hmac(deviceId) for anonymous submissions, on the
  // reasoning that a keyed hash identifies nobody. It identified
  // everybody: the SAME column stores deviceId in CLEARTEXT for named
  // submissions, so the candidate set was not guessed, it was
  // SELECT DISTINCT "deviceId". Hash each, match deviceHash, and the
  // anonymous receipt's clientId is the anonymous REPORT's clientId.
  //
  // That is the clientId join this model's comment above says it
  // fixed, one layer over — and the fix is what created it. It was
  // read by nothing: three writes, zero reads. Duplicates are caught
  // by @@unique([orgId, clientId]), which is the real mechanism.
  //
  // tests/integration/confidentiality.integration.test.ts runs the
  // unmasking end to end and requires it to return nothing.

  conflict   Boolean @default(false)
  resolution String?

  createdAt DateTime @default(now())

  org  Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Scoped to the org, not global. A globally unique clientId let any
  // authenticated caller probe whether an id existed in another
  // operator's tenancy.
  @@unique([orgId, clientId])
  @@index([orgId, createdAt])
  @@index([userId], map: "idx_syncreceipt_userid")
}

model AuditLog {
  id         String  @id @default(uuid())
  seq        BigInt  @default(autoincrement())
  orgId      String
  userId     String?
  action     String
  entityType String
  entityId   String
  detail     Json?

  // The chain. `hash` commits to every column above plus prevHash and
  // createdAt — see auditMaterial() in apps/api/src/core.ts, which is
  // the single definition both the writer and the verifier use.
  prevHash String
  hash     String

  createdAt DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // ===================================================================
  // RESTRICT, not SetNull, and the difference is the whole control.
  //
  // The chain's hash commits to `userId` — see auditMaterial() in
  // apps/api/src/audit-material.ts. SetNull therefore let an ordinary
  // administrative act rewrite the hashed content of every row naming a
  // departing member of staff, and every one of those rows stopped
  // matching its own hash. Reproduced:
  //
  //   chain BEFORE offboarding: {"ok":true,"rowsChecked":3}
  //   chain AFTER  offboarding: {"ok":false,"contentAlteredAtSeq":"4"}
  //
  // An audit log that spontaneously reports itself altered is
  // indistinguishable, to the regulator reading it, from one that was —
  // which is the sentence audit-material.ts already carries about key
  // ordering, arriving here through a foreign key.
  //
  // So the row cannot be deleted while the log names it. `User.active`
  // already exists and is what offboarding is supposed to use; the
  // integration test alongside this asserts the refusal and that the
  // chain still verifies afterwards.
  //
  // SafetyReport.reporterId stays SetNull deliberately: a report must
  // survive its author leaving, and nothing hashes it.
  // ===================================================================
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orgId, seq])
  @@index([userId], map: "idx_auditlog_userid")
}

// =====================================================================
// THE REST OF ANNEX 19.
//
// Everything above serves elements 2.1, 2.2, 3.1 and 3.2 — reporting,
// risk, indicators and change. The models below are the other eight,
// and they exist because /coverage has been telling operators for
// months that the product can score those elements and cannot do them.
//
// ONE SHAPE, REPEATED, BECAUSE THE ELEMENTS SHARE ONE. Almost every
// piece of SMS evidence an auditor asks for is: a versioned statement,
// approved by a named post on a date, distributed to people, with a
// record of who acknowledged it. That is not a coincidence — it is what
// "documented" means in a regulated system. So the models rhyme
// deliberately rather than each inventing its own vocabulary.
//
// WHAT IS NOT SHARED is what an auditor actually checks per element:
// a policy is signed by the accountable executive and nobody else; a
// finding has an owner and a verified closure; a training record
// expires. Those are columns, not a generic key-value bag, because a
// generic bag cannot be indexed, cannot be constrained, and cannot be
// queried for "what is overdue" — which is the only question anybody
// asks of this data.
//
// Every table is orgId-first, like the rest. Every write goes through
// the API and appends to the audit chain.
// =====================================================================

/// Element 1.1 — management commitment. The signed safety policy.
///
/// VERSIONED AND APPEND-ONLY. A safety policy that is edited in place
/// has no history, and the question an auditor asks is "what did it say
/// when the decision was taken". Superseding writes a new row; the old
/// one keeps its signature and its dates.
/// Regulation 13(3) of L.N. 32/2026 — the six things a service
/// provider's voluntary reporting system must DEFINE, and 13(2)'s
/// protection, held as the operator's own words.
///
/// ONE ROW PER OPERATOR, hence the unique orgId. This is not a log of
/// attempts; it is the current definition of the scheme, and a second
/// row would mean an operator whose voluntary system is defined twice
/// and differently — which is the thing an inspector would find.
///
/// EVERY FIELD IS NULLABLE, deliberately. An operator part-way through
/// defining its scheme has a real and common state, and forcing all six
/// at once would either block them from recording any of it or invite
/// placeholder text. What must never happen is the PRODUCT deciding an
/// undefined field is defined: unanswered() in packages/shared computes
/// which are still missing, and reports them as missing rather than
/// scoring them.
///
/// 13(2) IS PROSE, NOT A CHECKBOX. "Non-punitive and affording
/// protection to the sources" is a property the scheme must have, and a
/// tickbox saying so is a self-certification that looks like compliance
/// and evidences nothing. The operator states HOW.
model VoluntaryScheme {
  id           String   @id @default(uuid())
  orgId        String   @unique
  /// 13(3)(a) — the objective of the system.
  objective    String?  @db.Text
  /// 13(3)(b) — the sectors or areas it covers.
  scope        String?  @db.Text
  /// 13(3)(c) — who can report.
  whoMayReport String?  @db.Text
  /// 13(3)(d) — when to report.
  whenToReport String?  @db.Text
  /// 13(3)(e) — how reports are processed.
  howProcessed String?  @db.Text
  /// 13(3)(f) — the manager to be contacted. A POST, not a person, so
  /// the scheme survives the individual leaving.
  contactPost  String?  @db.Text
  /// 13(2) — how the scheme is non-punitive and protects its sources.
  protection   String?  @db.Text
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// NO `@@index([orgId])`. `orgId` is already @unique here — one config
  /// per operator — and a unique constraint IS an index. A second one on
  /// the same column serves no read and costs every write.
}

enum ChangeTrigger {
  FLEET
  ROUTE_OR_NETWORK
  ORGANISATION
  KEY_PERSONNEL
  EQUIPMENT_OR_SYSTEM
  PROCEDURE
  OTHER
}

enum ChangeStatus {
  DRAFT
  ASSESSED
  APPROVED
  IN_EFFECT
  REVIEWED
}

/// Element 3.2 — the management of change, held by the organisation.
///
/// The element's evidence definition is unusually precise: "a change
/// assessment for the most recent significant change, DATED BEFORE IT
/// HAPPENED". An assessment written after the fleet arrived is a
/// justification, and the difference between the two is the whole
/// element. Both dates are therefore stored and neither is derived —
/// `assessedOn` is when the thinking was done, `effectiveFrom` is when
/// the change takes effect, and their ORDER is what an inspector reads.
///
/// THE RISK POSITION IS STORED, for the same reason RiskAssessment's
/// is: an assessment is a decision taken on a date under the matrix as
/// it stood, and recomputing it if the scale is ever revised would
/// rewrite a decision somebody approved. Computed on write from the
/// same risk.ts the register and /methodology use.
///
/// APPROVAL IS A SEPARATE ACT from assessment, and separately
/// permissioned — moc.create writes it, moc.approve signs it. A change
/// its own author can approve is not routed.
model ChangeAssessment {
  id            String        @id @default(uuid())
  orgId         String
  title         String
  description   String        @db.Text
  trigger       ChangeTrigger
  /// When the thinking was done.
  assessedOn    DateTime
  /// When the change takes, or took, effect. Nullable while a change is
  /// still being planned — a date nobody has set is not the same as a
  /// change that happened today.
  effectiveFrom DateTime?

  severity     Severity
  likelihood   Likelihood
  score        Int
  tolerability Tolerability
  controls     String?      @db.Text

  residualSeverity     Severity?
  residualLikelihood   Likelihood?
  residualScore        Int?
  residualTolerability Tolerability?

  approvedById String?
  approvedAt   DateTime?

  /// The half operators most often skip: whether the change did what it
  /// was expected to. Element 3.2 is not discharged by assessing.
  reviewDueOn DateTime?
  reviewedOn  DateTime?
  reviewNotes String?   @db.Text

  status    ChangeStatus @default(DRAFT)
  updatedAt DateTime     @updatedAt
  createdAt DateTime     @default(now())

  org        Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  approvedBy User?              @relation("changeApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  actions    CorrectiveAction[]

  @@index([orgId, status])
  @@index([orgId, effectiveFrom])
  @@index([orgId], map: "idx_changeassessment_orgid")
  @@index([approvedById], map: "idx_changeassessment_approvedbyid")
}

model SafetyPolicy {
  id            String    @id @default(uuid())
  orgId         String
  version       Int
  statement     String    @db.Text
  /// Null until the accountable executive signs it. An unsigned policy
  /// is a draft, and element 1.1 is about the signature.
  signedById    String?
  signedOn      DateTime?
  effectiveFrom DateTime?
  supersededOn  DateTime?
  createdAt     DateTime  @default(now())

  org      Org                     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  signedBy User?                   @relation("policySignatory", fields: [signedById], references: [id], onDelete: Restrict)
  reads    PolicyAcknowledgement[]

  @@unique([orgId, version])
  @@index([orgId, supersededOn])
  @@index([signedById], map: "idx_safetypolicy_signedbyid")
}

/// Who has read the policy. Element 1.1's evidence that it reached
/// anybody, which is the half most operators cannot produce.
model PolicyAcknowledgement {
  id             String   @id @default(uuid())
  orgId          String
  policyId       String
  userId         String
  acknowledgedAt DateTime @default(now())

  org    Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  policy SafetyPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([policyId, userId])
  @@index([orgId, acknowledgedAt])
  @@index([orgId], map: "idx_policyacknowledgement_orgid")
  @@index([userId], map: "idx_policyacknowledgement_userid")
}

/// Element 1.2 — safety accountability and responsibilities.
///
/// A POST, NOT A PERSON. The question is whether each accountability has
/// an owner in the structure; who currently holds the post is a separate
/// fact that changes more often, and lives on Appointment below.
model Accountability {
  id             String   @id @default(uuid())
  orgId          String
  post           String
  responsibility String   @db.Text
  /// The Annex 19 element this accountability serves, so the matrix can
  /// be read against the framework rather than as a list.
  elementId      String?
  createdAt      DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, post])
}

/// Element 1.3 — appointment of key safety personnel.
model Appointment {
  id          String    @id @default(uuid())
  orgId       String
  post        String
  userId      String
  appointedOn DateTime
  /// The appointment letter's own reference, so the record points at the
  /// document rather than replacing it.
  letterRef   String?
  endedOn     DateTime?
  createdAt   DateTime  @default(now())

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation("appointee", fields: [userId], references: [id], onDelete: Restrict)

  @@index([orgId, post, endedOn])
  @@index([userId], map: "idx_appointment_userid")
}

/// Element 1.4 — emergency response planning, and the exercises that
/// are the only evidence a plan works.
model EmergencyExercise {
  id           String   @id @default(uuid())
  orgId        String
  scenario     String   @db.Text
  heldOn       DateTime
  /// Who else took part. An ERP that connects to nobody is a document.
  participants String   @db.Text
  findings     String   @db.Text
  planUpdated  Boolean  @default(false)
  createdAt    DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, heldOn])
}

/// Element 1.4 — WHO TO CALL, IN WHAT ORDER, WITH WHAT AUTHORITY.
///
/// The exercise record above answers what an inspector asks. This
/// answers what an operator needs at three in the morning, and it is
/// the half element 1.4's coverage entry has named as missing since it
/// was written.
///
/// SCOPED NARROW ON PURPOSE. Not a document editor: an ERP is a manual
/// with call-out trees, checklists and diagrams, and a worse version of
/// a Word file helps nobody. The directory is the part that goes stale
/// fastest, is needed fastest, and that a document cannot enforce.
///
/// verifiedOn IS THE WHOLE POINT. A contact directory is not wrong when
/// it is written; it goes wrong quietly. The duty officer's number
/// changes, the handling agent is bought, the doctor retires — and none
/// of that produces an event inside this product. Staleness is COMPUTED
/// against this date on every read (see packages/shared/src/erp.ts); a
/// stored "current" flag would say current forever.
///
/// NO STATUS COLUMN, for that reason. Charter rule 6.
model EmergencyContact {
  id    String @id @default(uuid())
  orgId String

  name String
  /// What they are for — "KCAA duty officer", "handling agent, Wilson",
  /// "next of kin coordinator". Free text: an operator's real call list
  /// is not this product's enum.
  role String

  organisation String?
  phone        String
  altPhone     String?
  email        String?

  /// Position in the call-out tree. Nullable, and sorted LAST when
  /// absent rather than first — a naive ascending sort on a nullable
  /// column puts the unordered contacts at the top of a list whose
  /// entire meaning is the order.
  callOrder Int?

  /// What this contact can actually authorise or release. The
  /// difference between a number and a useful number at 3am: knowing
  /// whether the person answering can move an aircraft, release a
  /// statement, or only take a message.
  authority String? @db.Text
  notes     String? @db.Text

  /// When somebody last confirmed this number reaches this person.
  /// Null means never — reported as its own state, not folded into
  /// stale, because the two need different things from a person.
  verifiedOn   DateTime?
  verifiedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org        Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("contactVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)

  /// The order the directory is read in, and the query that finds what
  /// has gone stale.
  @@index([orgId, callOrder])
  @@index([orgId, verifiedOn])
  @@index([orgId], map: "idx_emergencycontact_orgid")
  @@index([verifiedById], map: "idx_emergencycontact_verifiedbyid")
}

/// Element 1.5 — SMS documentation, under control.
model ControlledDocument {
  id           String    @id @default(uuid())
  orgId        String
  title        String
  reference    String
  version      String

  /// THE DOCUMENT ITSELF, WHICH IS WHY ELEMENT 1.5 WAS ONLY PARTIAL.
  ///
  /// This model has always carried what document CONTROL means as a
  /// discipline — reference, revision, approver, review date,
  /// supersession, and who has read the revision now in force. What it
  /// could not do was produce the document, so an inspector asking
  /// "show me revision 3" was sent to a shared drive, and the register
  /// described a file it could not vouch for.
  ///
  /// Held the same way evidence is, for the same reasons and with the
  /// same discipline: bytes in the row, a server-computed sha256 that
  /// is re-checked on the way out, an allowlisted content type, and no
  /// path ever built from a filename. A revision is immutable by
  /// construction — @@unique([orgId, reference, version]) — so the
  /// bytes never change under a version anybody has acknowledged.
  ///
  /// Nullable, because a register entry for a document held elsewhere
  /// is still a true register entry. The screen says which it is
  /// rather than implying every row has a file behind it.
  data        Bytes?
  contentType String?
  bytes       Int?
  sha256      String?
  /// Display only, for the download filename. Nothing is built from it.
  filename    String?
  approvedById String?
  approvedOn   DateTime?
  reviewBy     DateTime?
  supersededOn DateTime?
  createdAt    DateTime  @default(now())

  org        Org                       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  approvedBy User?                     @relation("documentApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  reads      DocumentAcknowledgement[]

  @@unique([orgId, reference, version])
  @@index([orgId, reviewBy])
  @@index([approvedById], map: "idx_controlleddocument_approvedbyid")
}

/// Element 1.5 — who has read which REVISION of a controlled document.
///
/// THE UNIQUE CONSTRAINT IS ON THE DOCUMENT ROW, AND THAT IS THE WHOLE
/// POINT. ControlledDocument is unique on (orgId, reference, version),
/// so every revision is its own row — which means an acknowledgement
/// keyed on documentId is keyed on a REVISION. Reading revision 3 does
/// not mark you as having read revision 4.
///
/// That is not a detail. It is what document control means and what
/// distinguishes a register of documents from a distribution record: an
/// operator that revises its SMS manual needs to know who has read the
/// version now in force, not who once read something with the same
/// title. A per-document key would report full coverage the moment a
/// revision shipped, which is the reassuring answer and the wrong one.
///
/// Mirrors PolicyAcknowledgement deliberately, down to the cascade
/// choices: the acknowledgement dies with its document and NEVER with
/// its user, because who read a revision is part of the record and an
/// offboarded person having read it remains true.
model DocumentAcknowledgement {
  id             String   @id @default(uuid())
  orgId          String
  documentId     String
  userId         String
  acknowledgedAt DateTime @default(now())

  org      Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  document ControlledDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([documentId, userId])
  @@index([orgId, acknowledgedAt])
  @@index([orgId], map: "idx_documentacknowledgement_orgid")
  @@index([userId], map: "idx_documentacknowledgement_userid")
}

/// Element 3.3 — continuous improvement. An internal SMS audit finding,
/// and the corrective action that closes it.
///
/// CLOSURE IS NOT THE SAME AS VERIFICATION, and conflating them is how
/// an operator ends up with a closed finding that never worked. Both
/// dates are here, and the API refuses to verify what is not closed.
model AuditFinding {
  id               String          @id @default(uuid())
  orgId            String
  auditRef         String
  finding          String          @db.Text
  /// The element the finding sits against, so an audit programme can be
  /// shown to cover the framework rather than whatever was noticed.
  elementId        String?
  severity         FindingSeverity @default(OBSERVATION)
  ownerPost        String
  dueBy            DateTime?
  correctiveAction String?         @db.Text
  closedOn         DateTime?
  verifiedById     String?
  verifiedOn       DateTime?
  createdAt        DateTime        @default(now())

  org        Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  verifiedBy User?              @relation("findingVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  actions    CorrectiveAction[]

  @@index([orgId, closedOn, dueBy])
  @@index([orgId, elementId])
  @@index([verifiedById], map: "idx_auditfinding_verifiedbyid")
}

enum FindingSeverity {
  NONCONFORMITY
  OBSERVATION
  IMPROVEMENT
}

/// A SET-I assessment is evidence-led. A rating without the linked
/// evidence, accountable post, and review date is deliberately not a
/// valid assessment item.
enum SetiAssessmentStatus {
  DRAFT
  COMPLETE
}

enum SetiLevel {
  PRESENT
  SUITABLE
  OPERATING
  EFFECTIVE
}

model SetiAssessment {
  id          String               @id @default(uuid())
  orgId       String
  title       String
  scope       String               @db.Text
  assessedOn  DateTime
  status      SetiAssessmentStatus @default(DRAFT)
  assessorId  String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  org       Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assessor  User                 @relation("setiAssessor", fields: [assessorId], references: [id], onDelete: Restrict)
  items     SetiAssessmentItem[]

  @@index([orgId, assessedOn])
  @@index([assessorId], map: "idx_setiassessment_assessorid")
}

model SetiAssessmentItem {
  id            String    @id @default(uuid())
  assessmentId  String
  criterionId   String
  level         SetiLevel?
  evidence      String?   @db.Text
  sourceRefs    String?   @db.Text
  ownerPost     String?
  reviewDueOn   DateTime?
  assessorNotes String?   @db.Text
  updatedAt     DateTime  @updatedAt

  assessment SetiAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, criterionId])
  @@index([criterionId])
}

/// Element 4.1 — training and education.
///
/// EXPIRY IS THE POINT. A training matrix nobody can query for "what
/// lapses this quarter" is a spreadsheet, and the finding an auditor
/// writes is about the expired row rather than about the matrix.
model TrainingRecord {
  id          String    @id @default(uuid())
  orgId       String
  userId      String
  course      String
  completedOn DateTime
  expiresOn   DateTime?
  createdAt   DateTime  @default(now())

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation("trainee", fields: [userId], references: [id], onDelete: Restrict)

  @@index([orgId, expiresOn])
  @@index([orgId, userId])
  @@index([userId], map: "idx_trainingrecord_userid")
}

/// Element 4.2 — safety communication, in both directions.
///
/// A bulletin published to the organisation, and — the half that
/// actually decides whether people keep reporting — what the reporter
/// was told happened as a result of theirs.
model SafetyCommunication {
  id            String   @id @default(uuid())
  orgId         String
  title         String
  body          String   @db.Text
  publishedOn   DateTime @default(now())
  publishedById String?
  /// Set when this is feedback ABOUT a specific report rather than a
  /// general bulletin. Never set for an anonymous report: there is
  /// nobody to tell, and a row joining feedback to an anonymous report
  /// is the re-identification the sync path was fixed to prevent.
  reportId      String?

  org         Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  publishedBy User?         @relation("communicator", fields: [publishedById], references: [id], onDelete: Restrict)
  report      SafetyReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([orgId, publishedOn])
  @@index([publishedById], map: "idx_safetycommunication_publishedbyid")
  @@index([reportId], map: "idx_safetycommunication_reportid")
}

/// What THIS operator calls things, and nothing else.
///
/// EVERY COLUMN HERE IS A PREFERENCE. The line between preference and
/// law is argued in packages/shared/src/tenant.ts and enforced by a
/// claims gate over this model's field names — because the way that
/// line gets crossed is not somebody deciding to cross it, it is a
/// settings screen growing one more field that seemed harmless.
///
/// NOTHING IN THIS MODEL IS A DEADLINE, A TOLERABILITY BAND, AN ELEMENT
/// DEFINITION OR A DE-IDENTIFICATION RULE. Those come from the
/// instrument, from Doc 9859, from Annex 19 and from L.N. 32's Third
/// Schedule respectively, and an operator that could edit them would
/// have bought a compliance tool that cannot be relied on for
/// compliance.
///
/// THE LABEL MAPS ARE KEYED BY THE FRAMEWORK'S OWN KEYS and unknown
/// keys are dropped on the way in. That is what makes the scales
/// RELABELLABLE and not REDEFINABLE: an operator can call
/// A_CATASTROPHIC whatever its manual calls it, and cannot add a sixth
/// severity, reorder the five, or change what A x 5 scores. Storing the
/// scale itself as rows would have been the easy shape and the wrong
/// one — a tenant with four severities makes tolerability() index past
/// the end, and "what band is this" becomes a question about whose
/// database you are reading.
model OrgConfig {
  id    String @id @default(uuid())
  orgId String @unique

  // Renames only. Keys are Severity / Likelihood / post codes.
  severityLabels   Json?
  likelihoodLabels Json?
  postTitles       Json?

  // The operator's own estate, ADDED to what the product ships rather
  // than replacing it — an operator who adds one strip must not lose
  // every other aerodrome from a reporter's dropdown.
  aerodromes    String[]
  aircraftTypes String[]

  // The operator's own default review cycle, in days.
  reviewDefaultDays Int?

  /// WHO MAY DECIDE TOLERABILITY, which L.N. 32 makes the operator's
  /// job rather than this product's.
  ///
  /// Paragraph 1.2.1(e) obliges a service provider to "define the
  /// levels of management with authority to make decisions regarding
  /// safety risk tolerability". Until this column existed the product
  /// answered that for every operator through a fixed role permission,
  /// so an auditor asking to see the operator's own definition had
  /// nothing to be shown.
  ///
  /// Keyed by tolerability band, valued by post code. INTOLERABLE is
  /// never a key — normaliseConfig drops it — because no level of
  /// management may accept a red risk and a column that could hold one
  /// is an invitation to believe otherwise.
  decisionLevels Json?

  /// THE OPERATOR'S MARK, for the documents they hand over.
  ///
  /// A base64 data URI rather than a key into object storage, and that
  /// is a departure from where evidence photos go. A logo is ONE small
  /// image per operator that has to render inside a PRINTED page: a
  /// print dialog does not wait for a network fetch, and a pack has to
  /// print at a remote strip with no signal. Held in the row the print
  /// block already reads, it needs no second request and no bucket
  /// policy to get wrong separately.
  ///
  /// Capped, allowlisted and SVG-refused by checkLogo() in
  /// packages/shared/src/logo.ts — the ceiling is on the encoded
  /// string, because that is what is stored and parsed. SVG is markup
  /// that can carry script and this renders into the operator's own
  /// pages, so raster only.
  logo          String?
  logoUpdatedAt DateTime?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// NO `@@index([orgId])`. `orgId` is already @unique here — one config
  /// per operator — and a unique constraint IS an index. A second one on
  /// the same column serves no read and costs every write.
}


/// EVIDENCE ATTACHED TO A REPORT — a photograph of the damage, a scan
/// of a form, the techlog page somebody wrote on.
///
/// THE BYTES ARE NOT HERE. This row is the RECORD of an attachment; the
/// file lives in object storage under `key`. A photograph is megabytes
/// and there may be six of them per report, which in a column would
/// inflate every backup, every SELECT that forgot to narrow, and every
/// statement crossing the transaction pooler. The logo went in a column
/// precisely because it is the opposite case — one small image that has
/// to render inside a printed page.
///
/// WHAT MAKES IT EVIDENCE RATHER THAN AN ASSERTION is `sha256`. The
/// audit chain covers this row, so the chain covers the hash, so a file
/// swapped in storage after the fact no longer matches what the chain
/// attests. Without it "the file changed" is unanswerable, and an
/// attachment nobody can vouch for is not evidence.
model ReportAttachment {
  id       String @id @default(uuid())
  orgId    String
  reportId String

  /// `<orgId>/<reportId>/<id>` — built by evidenceKey(), never from a
  /// filename. A filename is attacker-chosen text and `../` in one is
  /// how a storage path becomes somebody else's.
  key String @unique

  /// Allowlisted by checkEvidence(). No SVG anywhere in this product.
  contentType String
  bytes       Int
  /// Lowercase hex of the uploaded bytes. See the note above.
  sha256      String

  /// What the reporter called it, for a human reading the list. Display
  /// ONLY — nothing is ever built from it, least of all a path.
  label String?

  /// THE BYTES, WHEN THERE IS NO OBJECT STORE TO PUT THEM IN.
  ///
  /// Evidence is not optional to reporting — a hazard report about a
  /// cracked bracket is worth a great deal less than the photograph of
  /// it — so this product refuses to make it wait on a second
  /// credential. When SUPABASE_SERVICE_ROLE_KEY is configured the file
  /// goes to the bucket and this is null; when it is not, the file
  /// lives here, in the database the API already holds.
  ///
  /// THAT IS NOT A COMPROMISE AT THIS SCALE. A cap of 3 MB and six
  /// files a report puts the worst case at 18 MB per report for an
  /// operator flying three to fifteen aircraft. Postgres stores it out
  /// of line automatically and never reads it unless it is selected —
  /// and no query in this product selects it except the one download
  /// route. `OrgConfig.logo` already holds an image for the same
  /// reason.
  ///
  /// It also makes the export genuinely complete and removes a whole
  /// class of failure: one store, one credential, one place a
  /// regulator's evidence can be.
  data Bytes?

  uploadedById String?
  createdAt    DateTime @default(now())

  org    Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  report SafetyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  /// orgId FIRST, as on every tenant-owned table here: every read is
  /// scoped to one operator before it is narrowed to one report, so a
  /// composite in that order serves the query as written.
  @@index([orgId, reportId])
}

// =====================================================================
// THE DUTY LIMITS THIS OPERATOR IS BOUND BY, IN ITS OWN WORDS.
//
// THIS PRODUCT SHIPS NO FLIGHT-TIME TABLE FOR ANY STATE, and that is a
// decision rather than an omission. Kenya's flight and duty time
// limitations were searched for and the numbers did not come back;
// kcaa.or.ke is blocked at the egress proxy, so the instrument could
// not be opened either. A limit table nobody has read the instrument
// for is the one kind of wrong this product cannot ship — the same
// sentence CICTT_VERIFIED_AGAINST_PRIMARY carries — and here it would
// produce a screen telling an operator it is legal when it is not.
//
// So the operator declares what binds it and NAMES THE INSTRUMENT.
// `instrument` is non-nullable for that reason: a limit with no source
// is a number somebody typed, and the whole point of this row is that
// somebody can go and check it.
//
// It is strictly better than a table would have been. An operator whose
// AOC conditions are tighter than the regulation is measured against
// what actually binds it; an operator whose operations manual promises
// more than the law is held to its own promise; and an operator outside
// Kenya is served on the day it signs up.
//
// ONE PER ORG, and the numbers are all optional so an operator part-way
// through writing its OM can declare what it knows. A blank is reported
// as "not declared" and never as unlimited — see fatigue.ts, where
// treating a blank as unlimited is the check that cannot fail.
// =====================================================================
model FatigueLimit {
  id    String @id @default(uuid())
  orgId String @unique

  maxFlightTimeHours      Float?
  maxDutyHours            Float?
  minRestHours            Float?
  maxFlightTime7DaysHours Float?

  /// "KCAR 2025 Operation of Aircraft, Eighth Schedule", "OM-A 7.1",
  /// "AOC condition 4" — whatever the operator can be held to.
  instrument String

  /// Bare id rather than a relation, following retractedById and
  /// reportedToAuthorityById above. A user row cannot be deleted while
  /// the audit log names it, so the id stays resolvable.
  declaredById String?
  declaredOn   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)
}
