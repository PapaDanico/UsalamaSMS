{
  "name": "usalamasms",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "UsalamaSMS \u2014 aviation safety management for operators the incumbents priced out. Offline-first, Annex 19 Amendment 2 native.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite --config apps/web/vite.config.js",
    "check:brand": "node scripts/check-brand.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "check": "npm run prisma:generate && npm run typecheck && npm run check:brand && npm run check:claims && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run check && vite build --config apps/web/vite.config.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "prisma": "^7.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@prisma/client": "^7.0.0",
    "argon2": "^0.41.1",
    "dexie": "^4.0.10",
    "fastify": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  }
}
