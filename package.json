{
  "name": "usalamasms",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "UsalamaSMS — aviation safety management for operators the incumbents priced out. Offline-first, Annex 19 Amendment 2 native.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite --config apps/web/vite.config.js",
    "check:brand": "node scripts/check-brand.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "check:css": "node scripts/check-css.mjs",
    "check": "npm run prisma:generate && npm run typecheck && npm run check:brand && npm run check:claims && npm run check:css && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run check && npm run icons && vite build --config apps/web/vite.config.js && npm run stamp-sw",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/build-icons.mjs",
    "stamp-sw": "node scripts/stamp-sw.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run build && npm run smoke",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:up": "bash scripts/local-db.sh",
    "seed": "node scripts/seed.mjs"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "playwright": "^1.56.1",
    "prisma": "^7.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.0.0",
    "argon2": "^0.41.1",
    "dexie": "^4.0.10",
    "fastify": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "zod": "^3.23.8"
  }
}
