{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": { "@usalamasms/shared": ["./packages/shared/src/index.ts"] }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "tests/**/*.ts", "netlify/**/*.mts", "*.ts"]
}
