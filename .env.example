# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# NAMES ONLY IN THIS FILE. A committed example with a real value in it is
# the most common way a credential reaches a public repository, because
# it looks like documentation rather than like a secret.

# Direct Postgres connection, including the password.
# Supabase → Project → Connect → Direct connection → URI.
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Signs access tokens and keys the HMACs used for refresh-token storage
# and reporter duplicate-detection. Rotating it logs everyone out AND
# makes existing duplicate-detection tokens unmatchable — see
# docs/06-DEPLOYMENT.md before you do it.
JWT_SECRET="a long random string"

# Salts the irreversible reporter token in the de-identification path.
# Read at boot; a missing value fails the deploy rather than the first
# confidential report.
DEIDENT_SALT="another long random string"

# Optional.
LOG_LEVEL="info"
PORT="8080"

# DELIBERATELY ABSENT: the Supabase anon / publishable key.
# This codebase does not use the Supabase client SDK or PostgREST — the
# API talks to Postgres through Prisma and the browser talks only to the
# API. Adding the key here would invite a second, unaudited path to the
# same rows.
