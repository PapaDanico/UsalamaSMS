# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# NAMES ONLY IN THIS FILE. A committed example with a real value in it is
# the most common way a credential reaches a public repository, because
# it looks like documentation rather than like a secret.

# Direct Postgres connection, including the password.
# Supabase → Project → Connect → Direct connection → URI.
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Signs access tokens and keys the HMACs used for refresh-token storage
# and reporter duplicate-detection. Rotating it logs everyone out AND
# makes existing duplicate-detection tokens unmatchable — see
# docs/06-DEPLOYMENT.md before you do it.
JWT_SECRET="a long random string"

# Salts the irreversible reporter token in the de-identification path.
# Read at boot; a missing value fails the deploy rather than the first
# confidential report.
DEIDENT_SALT="another long random string"

# Sends the daily digest. OPTIONAL, AND ITS ABSENCE IS A SUPPORTED
# STATE rather than a broken one: with no key the digest is computed and
# rendered as normal and simply not transmitted, and the caller is TOLD
# it was not transmitted. A notification path that silently does nothing
# is worse than one that does not exist, because the first looks like it
# is working.
#
# Resend -> API keys. Scope it to SENDING ACCESS ONLY. The digest never
# reads the account, so a full-access key here would be a wider
# credential than the job needs.
#
# In production this lives in the Netlify environment, never in a file
# the repository tracks.
RESEND_API_KEY="re_..."

# Where a digest links back to. Absolute, because an email cannot
# resolve a path — and it is composed with the digest's own path rather
# than taken from a request header, so a forged Host cannot redirect an
# operator's staff to somebody else's site.
PUBLIC_BASE_URL="https://usalamasms.com"

# Optional.
LOG_LEVEL="info"
PORT="8080"

# DELIBERATELY ABSENT: the Supabase anon / publishable key.
# This codebase does not use the Supabase client SDK or PostgREST — the
# API talks to Postgres through Prisma and the browser talks only to the
# API. Adding the key here would invite a second, unaudited path to the
# same rows.

# How many rows one export file may carry per collection. The route
# REFUSES rather than truncating past it: a shortened export looks
# exactly like a complete one to whoever is handed it, and that file is
# evidence. Unset in every deploy — the default is what production runs,
# and this exists so the refusal itself can be executed by a test rather
# than asserted by a comment. Clamped to at least 1.
EXPORT_ROW_LIMIT="20000"
